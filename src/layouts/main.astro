---
import "@/styles/global.css"
import Navbar from "@/components/navigation/navbar-main"
import Footer from "@/components/navigation/footer"
import WhatsAppButton from "@/components/whatsapp-button"
import { ClientRouter } from "astro:transitions"
import { MobileNavDialog } from "@/components/navigation/mobile-nav"
import { getNavbarSection } from "@/utils/sections/navbar"
import { getContact } from "@/utils/core-detail/contact"
import { getSiteDetails } from "@/utils/core-detail/site-detail"
import { SEOMETADATA } from "@/components/meta-data/default-metadata"
import { getMetadataByName } from "@/utils/meta-data/create-meta"
// 1. Define component props interface
interface Props {
  pageName?: string
  context?: {
    title?: string
    description?: string
    image?: string
  }
}

// 2. Extract layout props
const { pageName, context } = Astro.props

const themeConfig = { name: "amber-mono-light", file: "default.css" }

const canonicalURL = Astro.url.href

// 3. Generate the class selector string dynamically matching your CSS block
const themeClass = `theme-${themeConfig.name}`

const navbarData = getNavbarSection()

const siteDetail = getSiteDetails()

const contact = getContact()

const meta = getMetadataByName(pageName, context)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <ClientRouter />
    <!-- 5. Linked stylesheet is placed AFTER globals.css to safely override variables -->
    <link rel="stylesheet" href={`/themes/${themeConfig.file}`} />
    <SEOMETADATA
      title={meta.title}
      description={meta.description}
      image={meta.image}
      siteName={siteDetail.title}
      url={canonicalURL}
    />
  </head>

  <body class={themeClass}>
    <Navbar>
      <MobileNavDialog
        navbarData={navbarData}
        siteDetail={siteDetail}
        phone={contact.phone}
        client:load
      />
    </Navbar>
    <main class="min-h-screen px-4 py-20 md:px-6">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton whatsapp={contact.whatsapp} />
  </body>
</html>
