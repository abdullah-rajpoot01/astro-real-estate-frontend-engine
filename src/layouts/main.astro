---
import "@/styles/global.css"
import Navbar from "@/components/navigation/navbar-main"
import Footer from "@/components/navigation/footer"
import WhatsAppButton from "@/components/whatsapp-button"
import { ClientRouter } from "astro:transitions"
import { MobileNavDialog } from "@/components/navigation/mobile-nav"
import { getNavbarSection } from "@/utils/navbar"
import { getContact } from "@/utils/contact"

const themeConfig = { name: "amber-mono-light", file: "default.css" }
 
// 3. Generate the class selector string dynamically matching your CSS block
const themeClass = `theme-${themeConfig.name}`

const navbarData = getNavbarSection()

const contact = getContact()
---

<html lang="en" > 
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Real Estate Frontend</title>
    <ClientRouter />
    <!-- 5. Linked stylesheet is placed AFTER globals.css to safely override variables -->
    <link rel="stylesheet" href={`/themes/${themeConfig.file}`} />
  </head>

  <body class={themeClass}>
    <Navbar>
      <MobileNavDialog navbarData={navbarData} client:load />
    </Navbar>
    <main class="min-h-screen px-4 py-20 md:px-6">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton whatsapp={contact.whatsapp} />
  </body>
</html>
