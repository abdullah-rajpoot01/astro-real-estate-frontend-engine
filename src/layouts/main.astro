---
import "@/styles/global.css"
import { FooterComp, NavbarComp } from "@/features/navigation"
import WhatsAppButton from "@/components/whatsapp-button"
import { ClientRouter } from "astro:transitions"
import { MobileNavDialogComp } from "@/features/navigation/mobile-nav.comp"
import { getNavbarData } from "@/features/navigation/navbar.utils"
import { getContact } from "@/features/core-detail/contact.utils"
import { getSiteDetails } from "@/features/core-detail/site-detail.utils"
import { SEOMETADATAComp } from "@/features/metadata/create.comp"
import { getMetadataByPageName } from "@/features/metadata"
import { getStoreBranding } from "@/features/core-detail/branding.utils"
import { themeConfig } from "@/features/reusable/theme-config.static"

// 1. Define component props interface
interface Props {
  pageName?: string
  context?: {
    title?: string | null
    description?: string | null
    image?: string | null
  }
}

// 2. Extract layout props
const { pageName, context } = Astro.props

const { theme, mode } = getStoreBranding()

const activeTheme = themeConfig.find((tme) => tme.value === theme)

const canonicalURL = Astro.url.href

// 3. Generate the class selector string dynamically matching your CSS block
const themeClass = `theme-${activeTheme?.value || "default"}-${mode}`

const navbarData = getNavbarData()

const siteDetail = getSiteDetails()

const contact = getContact()

const meta = getMetadataByPageName(pageName, context)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <ClientRouter />
    <!-- 5. Linked stylesheet is placed AFTER globals.css to safely override variables -->
    {
      activeTheme && activeTheme.value !== "default" && (
        <link rel="stylesheet" href={`/themes/${activeTheme.file}`} />
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEOMETADATAComp
      title={meta.title}
      description={meta.description}
      image={meta.image}
      siteName={siteDetail.title}
      url={canonicalURL}
    />
  </head>

  <body class={`${themeClass} ${mode}`}>
    <NavbarComp>
      <MobileNavDialogComp
        navbarData={navbarData}
        siteDetail={siteDetail}
        phone={contact.phone}
        client:load
      />
    </NavbarComp>
    <main class="min-h-screen px-4 py-20 md:px-6">
      <slot />
    </main>
    <FooterComp />
    <WhatsAppButton whatsapp={contact.whatsapp} />
  </body>
</html>
