---
// src/pages/properties/[...page].astro
import type { GetStaticPaths, Page } from "astro"
import type { Listing } from "@/types/listing"
import Layout from "@/layouts/main.astro"
import { getAllListings } from "@/utils/listings"
import PaginationWithPrimaryButton from "@/components/pagination-02"
import PropertyListingPage from "@/components/listings/properties-page"

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allListings = getAllListings()

  // Filter for available listings (or 'pending' if you still want to show them)
  const activeListings = allListings.filter(
    (item) => item.status //=== "available" || item.status === "pending"
  )

  // Paginate all active properties safely with 12 slots per page layout
  return paginate(activeListings, {
    pageSize: 2,
  })
}

interface Props {
  page: Page<Listing>
}

const { page } = Astro.props

const listingsOnThisPage = page.data
const baseUrl = "/properties/page"

// Clean pagination parsing logic handling optional index endpoints securely
const paginationInfo = {
  currentPage: page.currentPage,
  lastPage: page.lastPage,
  hasNext: typeof page.url.next === "string",
  hasPrev: typeof page.url.prev === "string",
  nextUrl: page.url.next,
  prevUrl: page.url.prev,
}
// Check total listings count for conditional visibility
const canShowPagination = listingsOnThisPage.length > 0 && paginationInfo.hasNext
---

<Layout title={`All Properties - Page ${page.currentPage}`}>
  <!-- Component rendering your main real estate listings catalog grid -->
  <PropertyListingPage listings={listingsOnThisPage} />

  <!-- Reusable pagination engine -->
  {
    canShowPagination && (
      <PaginationWithPrimaryButton
        baseUrl={baseUrl}
        pagination={paginationInfo}
      />
    )
  }
</Layout>
