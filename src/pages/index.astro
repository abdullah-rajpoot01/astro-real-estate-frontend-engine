---
import Layout from "@/layouts/main.astro"
import ListingSection from "@/features/home/listings.comp"
import HeroSection from "@/features/home/hero.comp"
import CarouselWithFooter from "@/features/home/hero-carousel.comp"
import Testimonials from "@/features/home/testimonials.comp"
import Features from "@/features/home/features.comp"
import CategoriesSection from "@/features/home/categories.comp"
import HomeCTA from "@/features/home/cta.comp"
import { getHeroSection } from "@/features/home/home.utils"

const { images } = getHeroSection()
---

<Layout pageName="home">
  <HeroSection>
    <CarouselWithFooter images={images} client:load />
  </HeroSection>
  <CategoriesSection />
  <ListingSection />
  <Features />
  <Testimonials />
  <HomeCTA />
</Layout>
