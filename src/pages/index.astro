---
import Layout from "@/layouts/main.astro"
import ListingSection from "@/components/home/listings-section"
import HeroSection from "@/components/home/hero-section"
import CarouselWithFooter from "@/components/home/hero-carousel"
import Testimonials from "@/components/home/testimonials"
import Features from "@/components/home/features"
import CategoriesSection from "@/components/home/categories-section"
import HomeCTA from "@/components/home/cta"
import { getHeroSection } from "@/utils/home-page"

const { carouselImages } = getHeroSection()
---

<Layout>
  <HeroSection>
    <CarouselWithFooter images={carouselImages} client:load />
  </HeroSection>
  <CategoriesSection />
  <ListingSection />
  <Features />
  <Testimonials />
  <HomeCTA />
</Layout>
