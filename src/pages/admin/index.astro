---
// src/pages/admin.astro
// 1. Import the central config file inside the Astro server context
import configs from "@/config/central-config.json"

// 2. Fetch the SITE_ID environment variable at build-time on the server
const siteId = process.env.SITE_ID

if (!siteId) {
  console.warn(
    "[CMS BUILD] Warning: Environment variable SITE_ID is not defined."
  )
}

// 3. Find the matching store tracking metadata block
const siteConfig = configs.find((item) => item.id === siteId) || {
  repositoryConfig: {
    repoName: "rajpoot/data_1", // Local fallback template target
    repoBranch: "main",
  },
}

const targetRepo = siteConfig.repositoryConfig.repoName
const targetBranch = siteConfig.repositoryConfig.repoBranch || "main"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Content Manager</title>
  </head>
  <body>
    <!-- Sveltia CMS requires this empty div to mount its user interface -->
    <div id="nc-root"></div>

    <script
      id="cms-config"
      is:inline
      data-repo={targetRepo}
      data-branch={targetBranch}
    >
      // This structural injection hook makes properties accessible to client execution tags
    </script>

    <script>
      // Import the CMS object directly from the npm package
      import CMS from "@sveltia/cms"
      import { sectionsCollection } from "@/cms/sections/collection"
      import { homePageCollection } from "@/cms/home-page/collection"
      import { aboutPageCollection } from "@/cms/about/collection"
      import { testimonialsPageCollection } from "@/cms/testimonials/collection"
      import { propertiesPageCollection } from "@/cms/properties/collection"
      import { categoriesPageCollection } from "@/cms/categories/collection"
      import { categoriesCollection } from "@/cms/categories/main"
      import { listingsCollection } from "@/cms/properties/main"
      import { agentsCollection } from "@/cms/agents/main"
      import { featuresCollection } from "@/cms/features/main"
      import { testimonialsCollection } from "@/cms/testimonials/main"
      import { coreDetailCollection } from "@/cms/core-detail/collection"

      // Pull the mapped environment configurations out of the script tag attributes
      const configElement = document.getElementById("cms-config")
      const gitHubRepo = configElement?.getAttribute("data-repo")
      const gitHubBranch = configElement?.getAttribute("data-branch")

      // Initialize with your JavaScript configuration object
      CMS.init({
        config: {
          load_config_file: false,
          // Backend provider (e.g., GitHub, GitLab, or Bitbucket)
          backend: {
            name: "github",
            repo: gitHubRepo || "rajpoot/data_1",
            branch: gitHubBranch || "main",
          },
          output: {
            omit_empty_optional_fields: true,
          },
          media_libraries: {
            default: {
              config: {
                max_file_size: 254800,
                transformations: {
                  raster_image: {
                    format: "webp",
                    quality: 80,
                  },
                },
              },
            },
          },
          // Where uploaded media assets will be saved
          media_folder: "public/images",
          public_folder: "/images",
          app_title: "Real Estate CMS",
          logo: {
            src: "https://islamabad-images-1.pages.dev/logos/201948.jpg",
            show_in_header: false,
          },
          // Define your Astro Content Collections here
          collections: [
            categoriesCollection,
            listingsCollection,
            agentsCollection,
            featuresCollection,
            testimonialsCollection,
            coreDetailCollection,
            sectionsCollection,
            homePageCollection,
            aboutPageCollection,
            testimonialsPageCollection,
            propertiesPageCollection,
            categoriesPageCollection,
          ],
        },
      })
    </script>
  </body>
</html>
